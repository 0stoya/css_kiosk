MAGENTO_BASE_URL=https://example.invalid
MAGENTO_STORE_CODE=default

# Required for the authenticated kiosk catalogue. Create a hidden Magento category such as
# "Kiosk Categories", put the kiosk-facing categories directly beneath it, and paste that
# parent category UID here. Category children own their image, label and display position.
KIOSK_MAGENTO_CATEGORY_ROOT_UID=REPLACE_WITH_MAGENTO_CATEGORY_UID

# Required in production. Development defaults to .data/kiosk.sqlite.
# KIOSK_DB_PATH=/srv/css-kiosk/data/kiosk.sqlite

# Server-side only. RSA private key used to sign one-use customer-session assertions for Magento.
# Never place this key in public/, source control, browser storage or the Android device.
KIOSK_MAGENTO_ASSERTION_PRIVATE_KEY_PATH=/srv/css-kiosk/keys/magento-assertion-private.pem

# Optional assertion contract override. Must match Magento configuration when changed.
# KIOSK_MAGENTO_ASSERTION_KEY_ID=css-kiosk-v1

# Optional GraphQL endpoint override. Leave unset to derive it from MAGENTO_BASE_URL.
# MAGENTO_GRAPHQL_URL=https://example.invalid/graphql

# Required for local-locker checkout. These values stay server-side; the browser cannot
# choose or override the delivery address, carrier or shipping method.
# Magento Css_Commerce must have CSS Locker Collection enabled for the same country/postcode.
KIOSK_LOCKER_LABEL=CSS Local Locker
KIOSK_LOCKER_STREET_1=Replace with physical locker address
# KIOSK_LOCKER_STREET_2=
KIOSK_LOCKER_CITY=Replace with locker city
# KIOSK_LOCKER_REGION=Essex
KIOSK_LOCKER_POSTCODE=AA1 1AA
KIOSK_LOCKER_COUNTRY_CODE=GB
KIOSK_LOCKER_TELEPHONE=Replace with locker contact number


# NEXT ARGO Customer API. Server-side only; never expose ARGO_API_KEY to browser/WebView code.
# Writes are disabled by default even when the key has write capabilities.
ARGO_API_URL=https://next.lanzigroup.com/customer-api
ARGO_API_KEY=REPLACE_WITH_KEY_ID_AND_SECRET
ARGO_DATABASE_UUID=fd346417-49e9-4c46-84a2-a6d8bc36678d
ARGO_PLANT_ID=150
ARGO_TERMINAL_TYPE=ArgoLK DYN
ARGO_TERMINAL_SERIAL=LK241103S
# ARGO_TIMEOUT_MS=10000
ARGO_WRITES_ENABLED=false

# Order → NEXT ARGO cart bridge. Keep disabled until the two date policies
# below have been agreed for this locker operation.
ARGO_ORDER_BRIDGE_ENABLED=false
# Required when ARGO_ORDER_BRIDGE_ENABLED=true. Use the agreed sentinel expiry
# date for non-expiring goods; no implicit default is applied.
ARGO_CART_NON_EXPIRING_EXPIRY_DATE=REPLACE_WITH_YYYY-MM-DD
# Required when ARGO_ORDER_BRIDGE_ENABLED=true. Expected arrival is calculated
# from the locker order date plus this many calendar days.
ARGO_CART_EXPECTED_ARRIVAL_OFFSET_DAYS=REPLACE_WITH_NON_NEGATIVE_INTEGER


# Kiosk UX timings. These are public build-time settings, not secrets.
# Welcome screen automatically advances to the catalogue after this delay.
NEXT_PUBLIC_KIOSK_WELCOME_DELAY_SECONDS=2
# Authenticated kiosk returns to the card screen after this many seconds with no
# touch/click, keyboard or scroll activity. Supported range: 10-900 seconds.
NEXT_PUBLIC_KIOSK_INACTIVITY_TIMEOUT_SECONDS=90


# Server-to-server secret shared only with css_admin for issuing short-lived
# Employee RFID enrollment codes. Use a strong random value and keep it out of
# browser/public environment variables.
KIOSK_EMPLOYEE_ENROLLMENT_SHARED_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
